# Copy to .env.local (Next.js) and .env (drizzle-kit). Never commit real values.

# Neon: Dashboard -> Connect -> Connection pooling ON
# Use a `dev` branch locally, never `production` (see docs/deploy.md).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Optional: the direct (non-pooled) URL, used by scripts/migrate.mts. On Vercel the Neon integration sets it.
# DATABASE_URL_UNPOOLED=

# Better Auth
# Generate with: openssl rand -base64 32   (or: npx @better-auth/cli secret)
BETTER_AUTH_SECRET=
# Required locally. On Vercel leave it unset: the app uses the production domain or the preview's URL.
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (optional in development: without a key, emails are saved as .html/.ics
# files in your OS temp folder, e.g. %TEMP%\meetready-emails on Windows)
RESEND_API_KEY=
EMAIL_FROM=MeetReady <onboarding@resend.dev>

# Error monitoring (optional; leave empty locally so nothing is sent). See docs/deploy.md step 10.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for uploading source maps (Vercel):
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Rate limiting (optional locally: without these, limits are kept in memory). See docs/deploy.md step 11.
# The Vercel Marketplace integration sets the KV_ names; UPSTASH_REDIS_REST_URL/TOKEN work too.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Background jobs: retries and reminders (Day 17). Optional locally: without them, jobs run inline
# after each request (no retries, no reminders). To try the real thing, run `npx inngest-cli@latest dev`
# and set INNGEST_DEV=1. On Vercel the Inngest integration sets both keys. See docs/deploy.md step 15.
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Google Calendar (Day 15) uses the Google OAuth client above: no extra variables. Only the E2E tests
# point these at a fake Google (playwright.config.ts):
# GOOGLE_CALENDAR_API_URL=
# GOOGLE_REVOKE_URL=

# Landing page "See a live booking page" link (optional), e.g. /sakifazwad18/intro
DEMO_BOOKING_PATH=
